//===========================================================================
// Updates the values of all preset conditions
//===========================================================================
function UpdateConditions takes nothing returns nothing
    set gCond_Light_Army = ( CaptainGroupSize(  ) >= 5 )
    set gCond_Medium_Army = ( ( CaptainGroupSize(  ) >= 14 ) or ( CheckLastCommandData( false ) == 1 ) )
    set gCond_Heavy_Army = ( ( CaptainGroupSize(  ) >= 16 ) or ( CheckLastCommandData( false ) == 1 ) )
    set gCond_Exp1_not_exist = ( GetMinesOwned(  ) <= 1 )
    set gCond_Keep_exist = ( GetUnitCountDone( 'h61S' ) > 0 )
    set gCond_Castle_exist = ( GetUnitCountDone( 'h61Z' ) > 0 )
    set gCond_Peasant_num_6 = ( GetUnitCountDone( 'h611' ) >= 5 )
    set gCond_Peasant_num_7 = ( GetUnitCountDone( 'h611' ) >= 6 )
    set gCond_Peasant_num_8 = ( GetUnitCountDone( 'h611' ) >= 8 )
    set gCond_need_farm = ( ( ( TotalFoodProduced(  ) - FoodUsed(  ) ) <= 10 ) and ( ( GetUnitCount( 'h622' ) - GetUnitCountDone( 'h622' ) ) == 0 ) )
    set gCond_Keep_and_Castle_not_exist = ( ( GetUnitCountDone( 'h61S' ) == 0 ) and ( GetUnitCountDone( 'h61Z' ) == 0 ) )
    set gCond_Castle_not_exist = ( GetUnitCountDone( 'h61Z' ) == 0 )
    set gCond_MTotem_exists = ( GetUnitCountDone( 'h62R' ) > 0 )
    set gCond_Lumbermill_exists = ( GetUnitCountDone( 'h62A' ) > 0 )
    set gCond_Exp1_exist = ( GetMinesOwned(  ) > 1 )
    set gCond_Lodgie_exists = ( GetUnitCountDone( 'h62G' ) > 0 )
    set gCond_Zverinec_exists = ( GetUnitCountDone( 'h62N' ) > 0 )
    set gCond_Keep_or_Castle_exist = ( ( GetUnitCountDone( 'h61S' ) > 0 ) or ( GetUnitCountDone( 'h61Z' ) > 0 ) )
    set gCond_Adv_units_1 = ( ( ( TotalFoodProduced(  ) - FoodUsed(  ) ) > 4 ) and ( ( GetGold(  ) > 500 ) and ( ( GetWood(  ) > 200 ) and ( ( GetUnitCountDone( 'h61S' ) == 0 ) and ( GetUnitCountDone( 'h61Z' ) == 0 ) ) ) ) )
    set gCond_Adv_units2 = ( ( ( TotalFoodProduced(  ) - FoodUsed(  ) ) > 4 ) and ( ( GetGold(  ) > 500 ) and ( ( GetWood(  ) > 200 ) and ( ( GetUnitCountDone( 'h61S' ) > 0 ) and ( GetUnitCountDone( 'h61Z' ) == 0 ) ) ) ) )
    set gCond_Adv_units3 = ( ( ( TotalFoodProduced(  ) - FoodUsed(  ) ) > 4 ) and ( ( GetGold(  ) > 500 ) and ( ( GetWood(  ) > 200 ) and ( GetUnitCountDone( 'h61Z' ) > 0 ) ) ) )
    set gCond_Attack_Enemy = ( CheckLastCommand( false ) == 1 )
    set gCond_kazarm_exist = ( GetUnitCountDone( 'h629' ) > 0 )
    set gCond_Fight_for_exp = ( ( ExpansionNeeded(  ) == true ) and ( CaptainGroupSize(  ) >= 5 ) )
    set gCond_dlya_ratyshi = ( ( GetUnitCount( 'h61S' ) == 0 ) and ( GetUnitCount( 'h61Z' ) == 0 ) )
    set gCond_kyzneca = ( GetUnitCountDone( 'h62A' ) > 0 )
    set gCond_bashnia = ( GetUnitCountDone( 'h62T' ) > 0 )
endfunction

