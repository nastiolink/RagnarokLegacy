        call SetBuildAll( BUILD_UNIT, 1, 'h625', -1 )
    endif
    if (gCond_Peasant_num_7) then
        call SetBuildAll( BUILD_UNIT, 1, 'h629', -1 )
    endif
    if (gCond_Peasant_num_8) then
        call SetBuildAll( BUILD_UNIT, 1, 'h62A', -1 )
    endif
    if (gCond_kazarm_exist) then
        call SetBuildAll( BUILD_UNIT, 1, 'h630', -1 )
    endif
