//===========================================================================
// Updates the values of all preset conditions
//===========================================================================
function UpdateConditions takes nothing returns nothing
    set gCond_Light_Army = ( CaptainGroupSize(  ) >= 5 )
    set gCond_Medium_Army = ( ( CaptainGroupSize(  ) >= 14 ) or ( CheckLastCommandData( false ) == 1 ) )
    set gCond_Heavy_Army = ( ( CaptainGroupSize(  ) >= 16 ) or ( CheckLastCommandData( false ) == 1 ) )
    set gCond_Exp1_not_exist = ( GetMinesOwned(  ) <= 1 )
    set gCond_Keep_exist = ( GetUnitCountDone( 'hkee' ) > 0 )
    set gCond_Castle_exist = ( GetUnitCountDone( 'hcas' ) > 0 )
    set gCond_Peasant_num_6 = ( GetUnitCountDone( 'hpea' ) >= 5 )
    set gCond_Peasant_num_7 = ( GetUnitCountDone( 'hpea' ) >= 6 )
    set gCond_Peasant_num_8 = ( GetUnitCountDone( 'hpea' ) >= 8 )
    set gCond_need_farm = ( ( ( TotalFoodProduced(  ) - FoodUsed(  ) ) <= 6 ) and ( ( GetUnitCount( 'hhou' ) - GetUnitCountDone( 'hhou' ) ) == 0 ) )
    set gCond_Keep_and_Castle_not_exist = ( ( GetUnitCountDone( 'hkee' ) == 0 ) and ( GetUnitCountDone( 'hcas' ) == 0 ) )
    set gCond_Castle_not_exist = ( GetUnitCountDone( 'hcas' ) == 0 )
    set gCond_MTotem_exists = ( GetUnitCountDone( 'hgra' ) > 0 )
    set gCond_Lumbermill_exists = ( GetUnitCountDone( 'hlum' ) > 0 )
    set gCond_Exp1_exist = ( GetMinesOwned(  ) > 1 )
    set gCond_Lodgie_exists = ( GetUnitCountDone( 'harm' ) > 0 )
    set gCond_Zverinec_exists = ( GetUnitCountDone( 'hars' ) > 0 )
    set gCond_Keep_or_Castle_exist = ( ( GetUnitCountDone( 'hkee' ) > 0 ) or ( GetUnitCountDone( 'hcas' ) > 0 ) )
    set gCond_Adv_units_1 = ( ( ( TotalFoodProduced(  ) - FoodUsed(  ) ) > 4 ) and ( ( GetGold(  ) > 500 ) and ( ( GetWood(  ) > 200 ) and ( ( GetUnitCountDone( 'hkee' ) == 0 ) and ( GetUnitCountDone( 'hcas' ) == 0 ) ) ) ) )
    set gCond_Adv_units2 = ( ( ( TotalFoodProduced(  ) - FoodUsed(  ) ) > 4 ) and ( ( GetGold(  ) > 500 ) and ( ( GetWood(  ) > 200 ) and ( ( GetUnitCountDone( 'hkee' ) > 0 ) and ( GetUnitCountDone( 'hcas' ) == 0 ) ) ) ) )
    set gCond_Adv_units3 = ( ( ( TotalFoodProduced(  ) - FoodUsed(  ) ) > 4 ) and ( ( GetGold(  ) > 500 ) and ( ( GetWood(  ) > 200 ) and ( GetUnitCountDone( 'hcas' ) > 0 ) ) ) )
    set gCond_Attack_Enemy = ( CheckLastCommand( false ) == 1 )
    set gCond_kazarm_exist = ( GetUnitCountDone( 'hbar' ) > 0 )
    set gCond_Fight_for_exp = ( ( ExpansionNeeded(  ) == true ) and ( CaptainGroupSize(  ) >= 5 ) )
    set gCond_dlya_ratyshi = ( ( GetUnitCount( 'hkee' ) == 0 ) and ( GetUnitCount( 'hcas' ) == 0 ) )
    set gCond_kyzneca = ( GetUnitCountDone( 'hbla' ) > 0 )
    set gCond_bashnia = ( GetUnitCountDone( 'hwtw' ) > 0 )
endfunction

